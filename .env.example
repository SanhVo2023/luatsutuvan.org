# Set to 1 to enable the Content Hub integration (hybrid: boilerplate + contact).
# 0 = pure local markdown (guides always render from disk regardless).
NEXT_PUBLIC_USE_HUB=0
NEXT_PUBLIC_SITE_URL=https://luatsutuvan.org
CONTACT_HUB_URL=https://script.google.com/macros/s/AKfycbxExampleHubDeploymentId000000000/exec

# --- Content Hub (only used when NEXT_PUBLIC_USE_HUB=1) ---
HUB_API_URL=https://cms.vothienhien.com
SITE_DOMAIN=luatsutuvan.org
# Numeric site-config id for this domain in the Hub (for contact-submissions linkage).
HUB_SITE_ID=
# Must equal the Hub's REVALIDATE_SECRET for on-demand ISR pings.
REVALIDATE_SECRET=
